{
  "name": "aegis-vault",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/crypto/cryptoEngine.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "portable:win": "npm run build && npx @tauri-apps/cli@^2.0.0 build --no-bundle",
    "android:init": "npm run build && npm i --no-save @capacitor/core @capacitor/cli @capacitor/android && npx cap add android && npx cap sync android",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
